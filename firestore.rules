rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Dynamic pricing — public read; one-time create so the app can seed from JSON
    match /settings/{docId} {
      allow read: if true;
      allow create: if docId == "pricing";
      allow update: if isAdmin();
      allow delete: if false;
    }

    // User profiles — created on signup; is_block only changeable in Firebase Console
    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.is_block == false
        && request.resource.data.email is string;

      allow read: if isOwner(userId) || isAdmin();

      allow update: if isAdmin()
        || (isOwner(userId)
          && request.resource.data.get('is_block', false) == resource.data.get('is_block', false)
          && request.resource.data.get('role', 'user') == resource.data.get('role', 'user')
          && request.resource.data.get('uid', userId) == resource.data.get('uid', userId));

      allow delete: if false;
    }

    // Support tickets
    match /tickets/{ticketId} {
      allow create: if request.resource.data.keys().hasAll([
          'ticketId', 'email', 'subject', 'description', 'status'
        ])
        && request.resource.data.status == 'Open'
        && request.resource.data.email is string
        && request.resource.data.subject is string
        && request.resource.data.description is string;
      allow read: if true;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Advisor profiles managed from the admin panel
    match /advisors/{advisorId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Session bookings
    match /bookings/{bookingId} {
      allow create: if request.resource.data.keys().hasAll([
          'bookingId', 'advisorId', 'date', 'time', 'mode', 'status', 'total'
        ])
        && (request.resource.data.status == 'Pending'
          || request.resource.data.status == 'Confirmed');
      allow read: if true;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Book-session page visits (funnel tracking)
    match /booking_visits/{visitId} {
      allow create: if isSignedIn()
        && request.resource.data.page == 'book-session'
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Browser crashes. Crashlytics has no web SDK, so the site writes here.
    match /crashes/{crashId} {
      allow create: if request.resource.data.keys().hasOnly([
          'message', 'stack', 'fatal', 'url', 'path', 'userAgent', 'userId', 'createdAt'
        ])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.stack is string
        && request.resource.data.stack.size() <= 4000
        && request.resource.data.fatal is bool
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 500
        && request.resource.data.path is string
        && request.resource.data.path.size() <= 300
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 300
        && (request.resource.data.userId == null || request.resource.data.userId is string)
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Payment attempts — written when someone taps pay, then marked paid or failed
    match /transactions/{txId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.advisorId is string
        && request.resource.data.advisorName is string
        && request.resource.data.email is string
        && request.resource.data.amount is number
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdAtClient is string;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && (request.resource.data.status == 'paid' || request.resource.data.status == 'failed')
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.advisorId == resource.data.advisorId
        && request.resource.data.advisorName == resource.data.advisorName
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.date == resource.data.date
        && request.resource.data.time == resource.data.time
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdAtClient == resource.data.createdAtClient
        && request.resource.data.email == resource.data.email;

      allow read: if isAdmin();
      allow delete: if false;
    }

    // Contact / inquiry forms
    match /contacts/{contactId} {
      allow create: if request.resource.data.email is string;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
