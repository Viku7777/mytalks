# Titan SMTP — copy this file to mail/.env and fill in your values.
# Never commit mail/.env to GitHub.

# Full Titan address you will send from (create this mailbox in Titan)
SMTP_USER=bookings@mytalk.in

# Titan mailbox password, or Application Password if 2FA is on
SMTP_PASS=your-titan-password-here

# Display name in the From field
SMTP_FROM_NAME=MyTalk Bookings

# Host / port (Titan defaults — change only if Titan support says so)
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true

# Where preview emails go when you run: npm run test:smtp / npm run send:templates
SMTP_TEST_TO=your-personal-email@gmail.com

# Also set these same SMTP_* values in the Vercel project Environment Variables
# so /api/send-booking-email can send real booking mail in production.
